# =============================================================================
# Hana CTC — master env reference
# Copy the blocks you need into each package's own .env (never commit real keys).
# =============================================================================

# ---- Shared: chains -----------------------------------------------------------
CC3_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CC3_CHAIN_ID=102031
CC3_EXPLORER_URL=https://creditcoin-testnet.blockscout.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_CHAIN_ID=11155111

# Attestcoin
ATTESTCOIN_PRECOMPILE=0x0000000000000000000000000000000000000FD2
ATTESTCOIN_PROVER_URL=https://prover.cc3-testnet.creditcoin.network
# Sepolia's chainKey as seen by the CC3 USC runtime — confirmed live via getSupportedChains()
# (returns { chainKey: 1, chainId: 11155111, chainName: "Sepolia ethereum" })
SOURCE_CHAIN_KEY=1

# ---- Deployer keys (test wallets only) --------------------------------------
# Funded with CC3 testnet CTC from the faucet
CC3_DEPLOYER_PRIVATE_KEY=
# Funded with Sepolia ETH from a faucet
SEPOLIA_DEPLOYER_PRIVATE_KEY=
# For `pnpm attestor:verify:sepolia` (Etherscan)
ETHERSCAN_API_KEY=

# ---- Contract addresses ------------------------------------------------------
# NOT env vars — deploy scripts write to deployments/<network>.json, and `pnpm sync:abis`
# publishes addresses + ABIs to packages/shared/src/generated/<network>.ts. Every consumer
# (worker, frontends) imports from there (WORKFLOW rule #1) — nothing to set here.

# ---- Worker -----------------------------------------------------------------
WORKER_SUBMITTER_PRIVATE_KEY=
WORKER_POLL_INTERVAL_MS=15000
WORKER_MAX_RETRIES=8
WORKER_STATE_DIR=./.worker-state
WORKER_HTTP_PORT=8787
WORKER_START_BLOCK=

# ---- Merchant API ---------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/hana_ctc
MERCHANT_API_PORT=3002
CHECKOUT_BASE_URL=http://localhost:3001
MERCHANT_INTERNAL_TOKEN=
SETTLEMENT_VAULT_DEPLOY_BLOCK=5434544

# ---- Frontends (NEXT_PUBLIC_* are exposed to the browser) -------------------
NEXT_PUBLIC_CC3_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
NEXT_PUBLIC_CC3_CHAIN_ID=102031
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_WORKER_STATUS_URL=http://localhost:8787
NEXT_PUBLIC_MERCHANT_API_URL=http://localhost:3002
