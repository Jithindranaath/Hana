# Package-local overrides. Next.js loads this automatically; NEXT_PUBLIC_* vars are bundled into
# the browser build, so nothing secret belongs here.

NEXT_PUBLIC_CC3_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
NEXT_PUBLIC_CC3_CHAIN_ID=102031
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional — enables WalletConnect (mobile wallets) in RainbowKit. Injected wallets (MetaMask,
# browser extensions) work without one. Get one free at https://cloud.reown.com.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

NEXT_PUBLIC_WORKER_STATUS_URL=http://localhost:8787
NEXT_PUBLIC_MERCHANT_API_URL=http://localhost:3002

# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser). Must match the Merchant API's
# own MERCHANT_INTERNAL_TOKEN. Used by app/api/mark-originated to mark a bill "originated" after
# a loan is originated against it — see that route's comment for why this can't be client-side.
MERCHANT_INTERNAL_TOKEN=

# Contract addresses come from @hana/shared's generated address book, NOT env vars (WORKFLOW
# rule #1) — nothing to set here for those.
