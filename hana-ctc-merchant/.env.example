# Package-local overrides. lib/env.ts also loads the repo-root .env as a fallback.

# Point this at a real MongoDB for production. For local dev with zero external setup, run
# `pnpm db:memory` in a separate terminal (mirrors `pnpm node` in hana-ctc-contracts) and copy
# the URI it prints here.
MONGODB_URI=mongodb://localhost:27017/hana_ctc

MERCHANT_API_PORT=3002
CHECKOUT_BASE_URL=http://localhost:3001
# Shared secret for POST /api/bills/:billHash/status — called by the checkout app / an indexer,
# not by merchants (they never see this).
MERCHANT_INTERNAL_TOKEN=dev-internal-token-change-me

# Read-only — for settlement history (SettlementVault events). No private key needed.
CC3_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
SETTLEMENT_VAULT_DEPLOY_BLOCK=5434544
