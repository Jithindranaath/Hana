# Package-local overrides. src/config.ts also loads the repo-root .env as a fallback,
# so you only need to set values here if they differ from the root.

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CC3_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
SOURCE_CHAIN_KEY=1
ATTESTCOIN_PROVER_URL=https://prover.cc3-testnet.creditcoin.network

# Funded with CC3 testnet CTC — submits importFromQuery (permissionless, any funded key works)
WORKER_SUBMITTER_PRIVATE_KEY=

WORKER_POLL_INTERVAL_MS=15000
WORKER_MAX_RETRIES=8
WORKER_STATE_DIR=./.worker-state
WORKER_HTTP_PORT=8787
# Sepolia block to backfill CreditSnapshot from on first boot. Leave unset to default to
# "current tip minus a lookback window" (see src/listener.ts) — set this to the attestor's
# deployment block (see hana-ctc-attestor/deployments/sepolia.json) for a deterministic backfill.
WORKER_START_BLOCK=

# CORS origin for the status endpoint (the checkout app). Leave unset to allow any origin (dev only).
CHECKOUT_BASE_URL=http://localhost:3001
